# =============================================================================
# REPO-MIND - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================



# =============================================================================
# SECTION 1: APPLICATION SETTINGS
# =============================================================================
# NODE_ENV controls how the app behaves.
# Use "development" locally, "production" when deployed.
# PORT is the network port our Express server listens on.
# =============================================================================

NODE_ENV=development
PORT=5000


# =============================================================================
# SECTION 2: FRONTEND URL
# =============================================================================
# This tells our backend where the frontend is running.
# During development, Next.js runs on port 3000 by default.
# In production, this would be your deployed frontend URL.
# We need this for CORS (Cross-Origin Resource Sharing) —
# a browser security feature that controls which domains
# can talk to our backend API.
# =============================================================================

FRONTEND_URL=http://localhost:3000


# =============================================================================
# SECTION 3: GITHUB OAUTH 2.0
# =============================================================================
# These credentials come from creating a "GitHub OAuth App".
# Steps to get them (do this later):
#   1. Go to github.com → Settings → Developer Settings
#   2. Click "OAuth Apps" → "New OAuth App"
#   3. Set Homepage URL: http://localhost:3000
#   4. Set Callback URL: http://localhost:5000/api/auth/github/callback
#   5. Click "Register Application"
#   6. Copy the Client ID and generate a Client Secret
#
# GITHUB_CLIENT_ID: Public identifier for our OAuth app
# GITHUB_CLIENT_SECRET: Private key — never share this
# GITHUB_CALLBACK_URL: Where GitHub redirects after login
# =============================================================================

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback


# =============================================================================
# SECTION 4: JWT (JSON WEB TOKEN) SECRET
# =============================================================================
# After a user logs in with GitHub, we create a JWT — a digitally signed
# "ticket" that proves who the user is. Every API request carries this ticket.
# The JWT_SECRET is the secret key we use to SIGN and VERIFY these tickets.
# If someone had this secret, they could forge tickets — keep it very secret!
#
# Generate a strong secret with this command in your terminal:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================

JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_replace_this
JWT_EXPIRES_IN=7d


# =============================================================================
# SECTION 5: POSTGRESQL DATABASE (via Neon or Supabase)
# =============================================================================
# This is the connection string to our relational database.
# It contains everything needed to connect: username, password, host, port, dbname.
#
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require
#
# How to get this:
#   Option A (Neon): Go to neon.tech → Create project → Copy "Connection string"
#   Option B (Supabase): Go to supabase.com → Project Settings → Database → URI
#
# DATABASE_URL is used by Prisma ORM to connect to PostgreSQL
# =============================================================================

DATABASE_URL=postgresql://username:password@host:5432/repo_mind_db?sslmode=require


# =============================================================================
# SECTION 6: PINECONE VECTOR DATABASE
# =============================================================================
# Pinecone stores our code embeddings (vectors) for semantic search.
#
# How to get these:
#   1. Go to pinecone.io → Sign up → Create a project
#   2. Go to "API Keys" → Copy your API key
#   3. Create an Index with:
#      - Dimensions: 384 (matches our embedding model all-MiniLM-L6-v2)
#      - Metric: cosine
#      - Name: repo-mind-index (or whatever you choose)
#   4. Copy the index name
#
# PINECONE_API_KEY: Your secret API key
# PINECONE_INDEX_NAME: The name of the index you created
# =============================================================================

PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=repo-mind-index


# =============================================================================
# SECTION 7: GROQ API (LLM - Large Language Model)
# =============================================================================
# Groq runs the LLaMA 3.3 70B model at extremely fast speeds.
# This is what powers our AI chat, bug detection, and documentation features.
#
# How to get this:
#   1. Go to console.groq.com → Sign up
#   2. Click "API Keys" → "Create API Key"
#   3. Copy the key (you only see it once!)
#
# GROQ_MODEL: The specific AI model we'll use
# =============================================================================

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile


# =============================================================================
# SECTION 8: HUGGING FACE API (Embeddings)
# =============================================================================
# Hugging Face hosts the all-MiniLM-L6-v2 model that converts text into
# vectors (embeddings). These vectors are what we store in Pinecone.
# Think of embeddings as translating text into a language of numbers
# that captures MEANING — similar sentences get similar numbers.
#
# How to get this:
#   1. Go to huggingface.co → Sign up
#   2. Click your profile → Settings → Access Tokens
#   3. Click "New Token" → Select "Read" role → Copy the token
#
# HUGGINGFACE_MODEL: The embedding model we use (384 dimensions)
# =============================================================================

HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2


# =============================================================================
# SECTION 9: REDIS (via Upstash)
# =============================================================================
# Redis is our caching and rate-limiting layer.
# Upstash provides a serverless Redis that works perfectly for our use case.
#
# How to get these:
#   1. Go to upstash.com → Sign up
#   2. Click "Create Database" → Choose a region close to you
#   3. Click on the database → Go to "REST API" section
#   4. Copy the UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
#
# REDIS_TTL: How long (in seconds) we cache responses (3600 = 1 hour)
# RATE_LIMIT_WINDOW: Time window for rate limiting in milliseconds
# RATE_LIMIT_MAX_REQUESTS: Max requests allowed per window per user
# =============================================================================

UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
REDIS_TTL=3600
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=20


# =============================================================================
# SECTION 10: SESSION SECRET
# =============================================================================
# Used to encrypt session data during the OAuth flow.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

SESSION_SECRET=your_session_secret_here_replace_with_random_string