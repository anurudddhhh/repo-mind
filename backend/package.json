{
  "name": "repo-mind-backend",
  "version": "1.0.0",
  "description": "Backend API server for Repo-Mind GitHub Knowledge Assistant",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r ./env-loader.js -r tsconfig-paths/register src/index.ts\"",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "prisma:generate": "dotenv -e ../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "prisma:studio": "dotenv -e ../.env -- prisma studio",
    "prisma:push": "dotenv -e ../.env -- prisma db push"
  },
  "keywords": [
    "github",
    "ai",
    "rag",
    "code-analysis",
    "ast"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/community": "0.3.37",
    "@langchain/core": "0.3.37",
    "@langchain/groq": "0.1.3",
    "@octokit/auth-token": "^6.0.0",
    "@octokit/rest": "^22.0.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "@prisma/client": "^5.22.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.19.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "16.4.5",
    "express": "4.18.3",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.19.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "0.3.37",
    "morgan": "^1.11.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "uuid": "^14.0.0",
    "web-tree-sitter": "^0.26.0",
    "winston": "^3.19.0",
    "zod": "3.22.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
